rules_version = '2';

// Reglas de seguridad de Firestore para EmilioMartelFx
// Cada usuario solo puede leer y escribir SUS documentos:
//   users/{uid}    perfil, progreso y certificados
//   avatars/{uid}  foto de perfil (aparte, para no descargarla con cada cambio de progreso)
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Administrador: solo puede LEER los perfiles (para el panel privado /admin), nunca modificarlos
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'emiliomtg@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      function validProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'email', 'photo', 'createdAt', 'updatedAt', 'progress', 'certificates', 'lastSeen', 'verified', 'source'])
          && d.name is string && d.name.size() <= 60
          && (!('photo' in d) || d.photo == null || (d.photo is string && d.photo.size() < 200000))
          && (!('progress' in d) || d.progress is map)
          && (!('certificates' in d) || d.certificates is map)
          && (!('source' in d) || d.source is map);
      }
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile();
    }

    match /avatars/{uid} {
      allow read, delete: if isOwner(uid);
      // Solo la foto (texto base64 de una imagen) y como máximo ~45 KB
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['photo', 'updatedAt'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('^data:image/(webp|jpeg);base64,.*')
        && request.resource.data.photo.size() < 60000;
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
